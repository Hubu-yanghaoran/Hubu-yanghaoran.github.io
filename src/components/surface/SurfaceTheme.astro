<script is:inline>
(()=>{try{document.documentElement.dataset.surface=localStorage.getItem('yhr-surface')==='glass'?'glass':'fuwari';}catch{document.documentElement.dataset.surface='fuwari';}})();
</script>
<style is:global>
[hidden] { display: none !important; }
html[data-surface=glass] { background: #dce7ee; }
html[data-surface=glass] body::before { content:''; position:fixed; inset:0; z-index:-1; background:linear-gradient(#eef5f878,#e6edf3b5),url('/glass-wallpaper.png') center/cover; pointer-events:none; }
html[data-surface=glass] .card-base, html[data-surface=glass] .float-panel { background:rgba(255,255,255,.78); border:1px solid rgba(255,255,255,.72); box-shadow:0 8px 30px #193e6410; backdrop-filter:blur(20px) saturate(125%); -webkit-backdrop-filter:blur(20px) saturate(125%); }
html.dark[data-surface=glass] body::before { background:linear-gradient(#101b2caa,#101b2cd9),url('/glass-wallpaper.png') center/cover; }
html.dark[data-surface=glass] .card-base, html.dark[data-surface=glass] .float-panel { background:rgba(24,31,43,.86); border-color:rgba(255,255,255,.12); }
@supports not (backdrop-filter:blur(1px)) {html[data-surface=glass] .card-base,html[data-surface=glass] .float-panel{background:#f5f9fc}html.dark[data-surface=glass] .card-base,html.dark[data-surface=glass] .float-panel{background:#1b2533}}
[data-surface-choice][aria-pressed=true] { outline:2px solid var(--primary);outline-offset:2px; }
</style>
<script>
const sync=()=>document.querySelectorAll<HTMLElement>('[data-surface-choice]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.surfaceChoice===(document.documentElement.dataset.surface||'fuwari'))));
document.addEventListener('click',event=>{
 const button=(event.target as Element)?.closest<HTMLElement>('[data-surface-choice]');if(!button)return;
 const value=button.dataset.surfaceChoice;if(!['glass','fuwari'].includes(value||''))return;
 document.documentElement.dataset.surface=value;sync();
 try{localStorage.setItem('yhr-surface',value!);}catch{const status=document.querySelector('[data-surface-status]');if(status)status.textContent='当前设置仅在本页生效。';}
});
document.addEventListener('surface-controls-ready',sync);
window.addEventListener('storage',event=>{if(event.key==='yhr-surface'){document.documentElement.dataset.surface=event.newValue==='glass'?'glass':'fuwari';sync();}});sync();
</script>
