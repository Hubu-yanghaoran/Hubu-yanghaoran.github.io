<focus-timer class="block space-y-4"><label class="block text-sm text-black/60 dark:text-white/60">专注时长（分钟）<input data-minutes type="number" min="1" max="180" value="25" class="rounded-lg bg-black/5 dark:bg-white/5 px-3 py-2 ml-3 w-24" /></label><output data-time class="block text-5xl font-bold text-[var(--primary)] tabular-nums">25:00</output><div class="flex gap-3"><button data-start class="btn-regular px-4 py-2 rounded-lg">开始</button><button data-reset class="btn-regular px-4 py-2 rounded-lg">重置</button></div><p data-status role="status" class="text-sm text-black/50 dark:text-white/50">计时状态保存在当前浏览器，离开页面后仍按截止时间计算。</p></focus-timer>
<script>
class FocusTimer extends HTMLElement {
 controller?:AbortController;timer?:ReturnType<typeof setTimeout>;remaining=1500;deadline=0;
 connectedCallback(){this.controller?.abort();this.controller=new AbortController();const signal=this.controller.signal;const input=this.querySelector<HTMLInputElement>('[data-minutes]')!;const start=this.querySelector<HTMLButtonElement>('[data-start]')!;const key='yhr-focus-v1';
 const save=()=>{try{localStorage.setItem(key,JSON.stringify({remaining:this.remaining,deadline:this.deadline,minutes:input.value}));}catch{this.querySelector('[data-status]')!.textContent='浏览器未允许保存，计时仅在本页有效。';}};
 const update=()=>{clearTimeout(this.timer);if(this.deadline){this.remaining=Math.max(0,Math.ceil((this.deadline-Date.now())/1000));if(!this.remaining){this.deadline=0;save();this.querySelector('[data-status]')!.textContent='本次专注已结束。';}}
 this.querySelector('[data-time]')!.textContent=String(Math.floor(this.remaining/60)).padStart(2,'0')+':'+String(this.remaining%60).padStart(2,'0');start.textContent=this.deadline?'暂停':'开始';input.disabled=!!this.deadline;if(this.deadline&&!document.hidden)this.timer=setTimeout(update,1000);};
 try{const state=JSON.parse(localStorage.getItem(key)||'null');if(state&&Number.isFinite(state.remaining)&&state.remaining>=0&&state.remaining<=10800&&Number.isFinite(state.deadline)&&state.deadline>=0&&state.deadline<=Date.now()+10800000){this.remaining=Math.round(state.remaining);this.deadline=state.deadline;const minutes=Number(state.minutes);if(minutes>=1&&minutes<=180)input.value=String(minutes);}}catch{}
 start.addEventListener('click',()=>{if(!input.reportValidity())return;if(this.deadline){update();this.deadline=0;}else{if(!this.remaining){this.remaining=Number(input.value)*60;}if(!Number.isInteger(this.remaining)||this.remaining<1||this.remaining>10800)return;this.deadline=Date.now()+this.remaining*1000;this.querySelector('[data-status]')!.textContent='专注计时中。';}save();update();},{signal});
 const reset=()=>{const minutes=Number(input.value);if(!Number.isInteger(minutes)||minutes<1||minutes>180){input.reportValidity();return;}this.deadline=0;this.remaining=minutes*60;this.querySelector('[data-status]')!.textContent='准备开始。';save();update();};this.querySelector('[data-reset]')!.addEventListener('click',reset,{signal});input.addEventListener('change',reset,{signal});document.addEventListener('visibilitychange',update,{signal});update();}
 disconnectedCallback(){clearTimeout(this.timer);this.controller?.abort();}
}
if(!customElements.get('focus-timer'))customElements.define('focus-timer',FocusTimer);
</script>
